[TEMPLATE]
# ---------------------------------------------------------------------------
# AI Provider - powers contract analysis (and future agent capabilities).
# Supported now: ollama_cloud (default), ollama_local, gemini.
# Ollama providers automatically fall back to Gemini when unreachable/erroring.
# Planned: vllm.
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama_cloud

# Ollama Cloud (default) - hosted models on ollama.com, no local machine required.
# Get an API key at https://ollama.com/settings/keys
# The OpenAI-compatible endpoint lives under /v1 (e.g. https://ollama.com/v1).
OLLAMA_BASE_URL=https://ollama.com/v1
# Model to use for hosted inference. Leave blank to use the provider default.
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Local Ollama (set AI_PROVIDER=ollama_local when using a local `ollama serve`).
# Requires the OpenAI-compatible /v1 endpoint at http://localhost:11434/v1
OLLAMA_LOCAL_BASE_URL=http://localhost:11434/v1
OLLAMA_LOCAL_MODEL=llama3.2

# Google AI (Gemini) - automatic fallback when Ollama is unavailable or
# errors (Ollama stays the primary provider). Get a key at
# https://aistudio.google.com/apikey (free tier available).
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is tried as a secondary fallback.
GEMINI_API_KEY=
# Optional: model override (default gemini-2.5-flash).
GEMINI_MODEL=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Clerk authentication
# 1. Create an app at https://dashboard.clerk.com (enable Google + Email/Password)
# 2. Copy the keys from the API Keys page into .env.local
# 3. Without keys the app runs in demo mode with local accounts; Clerk auth
#    and /dashboard protection are skipped so the app still runs out of the box.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional - where Clerk routes users for sign-in/sign-up and after auth
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth?mode=login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth?mode=signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ---------------------------------------------------------------------------
# PayPal subscriptions (Business plan)
# 1. Public values are safe to expose client-side; they power the subscribe
#    button in the Business upgrade screen.
# 2. The REST pair (PAYPAL_CLIENT_ID / PAYPAL_SECRET) is server-only: it
#    verifies a subscription is ACTIVE before Business mode is enabled, and
#    verifies webhook signatures.
# 3. PAYPAL_WEBHOOK_ID: create a webhook in the PayPal dashboard pointing at
#    https://<your-domain>/api/paypal/webhook and paste its ID here so
#    cancellations/expirations reach the app. Without it, Business mode is
#    verified at activation time but not revoked on cancellation.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Subscription plan id per paid tier (create each in PayPal Billing > Plans):
#   - NEXT_PUBLIC_PAYPAL_PLAN_ID     -> Business ($200/mo)
#   - NEXT_PUBLIC_PAYPAL_PLAN_TEAM_ID -> Team ($20/mo)
NEXT_PUBLIC_PAYPAL_PLAN_ID=
NEXT_PUBLIC_PAYPAL_PLAN_TEAM_ID=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional: override the PayPal API base for sandbox testing, e.g.
# https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=

# ---------------------------------------------------------------------------
# Gmail OAuth (Google) - real OAuth flow for reading vendor correspondence.
# 1. Create an OAuth client ID in Google Cloud Console (Application type:
#    Web application) for the project that owns your Gmail access.
# 2. Authorized redirect URIs must include exactly:
#      https://<your-domain>/api/gmail/callback
#    (and http://localhost:3000/api/gmail/callback for local dev).
# 3. Download the client_secret_*.json and copy the values here. These are
#    server-only - never expose GOOGLE_OAUTH_CLIENT_SECRET to the browser.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional override; defaults to <origin>/api/gmail/callback per request.
# Set it explicitly when the registered redirect URI differs.
GOOGLE_OAUTH_REDIRECT_URI=

# Encrypts Gmail tokens at rest (AES-256-GCM). Required to persist tokens.
# Generate with: openssl rand -base64 32
GMAIL_TOKEN_SECRET=

# Optional path for the encrypted-at-rest token file so connections survive
# restarts. On Render, point this at a mounted persistent disk, e.g.
# /data/gmail-tokens.json. Omit for memory-only (tokens lost on restart,
# users reconnect).
GMAIL_TOKEN_FILE=

# Optional path for the extraction-job store so in-flight analyses survive
# restarts and resume automatically (defaults to .data/extract-jobs.json).
# On Render, point this at the same mounted persistent disk, e.g.
# /data/extract-jobs.json.
EXTRACT_JOB_FILE=

# ---------------------------------------------------------------------------
# Supabase persistence - server-side workspace data so user info survives
# browsers, devices and logouts (auth stays with Clerk).
# 1. Create a project at https://supabase.com
# 2. Run this SQL in the SQL editor to create the store table:
#      create table if not exists user_data (
#        user_id text primary key,
#        data jsonb not null default '{}'::jsonb,
#        updated_at timestamptz not null default now()
#      );
# 3. Project Settings > API: copy the Project URL and the service_role
#    (secret) key here. Server-only - never expose the secret key.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=