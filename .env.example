[TEMPLATE]
# ---------------------------------------------------------------------------
# AI Provider - powers contract analysis (and future agent capabilities).
# Supported now: gemini (default), ollama_cloud, ollama_local.
# Gemini is the primary provider; it automatically falls back to Ollama Cloud
# when unreachable/erroring. Ollama providers in turn fall back to Gemini.
# Planned: vllm.
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini

# Google AI (Gemini, default) - primary inference provider. Get a key at
# https://aistudio.google.com/apikey (free tier available).
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is tried as a secondary fallback.
GEMINI_API_KEY=
# Optional: model override (default gemini-3.6-flash).
GEMINI_MODEL=
GOOGLE_API_KEY=

# Ollama Cloud - automatic fallback when Gemini is unavailable or errors
# (Gemini stays the primary provider). Hosted models on ollama.com.
# Get an API key at https://ollama.com/settings/keys
# The OpenAI-compatible endpoint lives under /v1 (e.g. https://ollama.com/v1).
OLLAMA_BASE_URL=https://ollama.com/v1
# Model to use for hosted inference. Leave blank to use the provider default.
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Local Ollama (set AI_PROVIDER=ollama_local when using a local `ollama serve`).
# Requires the OpenAI-compatible /v1 endpoint at http://localhost:11434/v1
OLLAMA_LOCAL_BASE_URL=http://localhost:11434/v1
OLLAMA_LOCAL_MODEL=llama3.2
# Per-request timeout for local inference. Local models run on your machine's
# CPU/GPU and are far slower than hosted endpoints, especially when the four
# extraction tasks run in parallel - the default is 300s (5 min). Hosted
# providers keep a 120s budget.
OLLAMA_LOCAL_TIMEOUT_MS=300000

# Whole-pipeline deadline for the four parallel extraction tasks (incl.
# retries), in ms. Default 100000 (100s) suits hosted providers; raise it
# for slow local models, e.g. 240000.
EXTRACT_PIPELINE_DEADLINE_MS=100000

# ---------------------------------------------------------------------------
# Clerk authentication
# 1. Create an app at https://dashboard.clerk.com (enable Google + Email/Password)
# 2. Copy the keys from the API Keys page into .env.local
# 3. Without keys the app runs in demo mode with local accounts; Clerk auth
#    and /dashboard protection are skipped so the app still runs out of the box.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keep Clerk's frontend API on Clerk's own CDN instead of auto-proxying it
# through /__clerk (auto-proxy only activates on Vercel *.vercel.app URLs).
# The auth script and session calls then never hop through this server.
CLERK_DISABLE_AUTO_PROXY=true

# Optional - where Clerk routes users for sign-in/sign-up and after auth
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth?mode=login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth?mode=signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ---------------------------------------------------------------------------
# PayPal subscriptions - collects subscription payments from customers.
# 1. Public values are safe to expose client-side; they power the subscribe
#    button in the Business upgrade screen.
# 2. The REST pair (PAYPAL_CLIENT_ID / PAYPAL_SECRET) is server-only: it
#    verifies a subscription is ACTIVE before Business mode is enabled, and
#    verifies webhook signatures.
# 3. PAYPAL_WEBHOOK_ID: create a webhook in the PayPal dashboard pointing at
#    https://<your-domain>/api/paypal/webhook and paste its ID here so
#    cancellations/expirations reach the app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Subscription plan id per paid tier (create each in PayPal Billing > Plans):
#   - NEXT_PUBLIC_PAYPAL_PLAN_ID     -> Business ($999 setup fee, then $1/yr)
#   - NEXT_PUBLIC_PAYPAL_PLAN_TEAM_ID -> Team ($20/mo)
NEXT_PUBLIC_PAYPAL_PLAN_ID=
NEXT_PUBLIC_PAYPAL_PLAN_TEAM_ID=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional: override the PayPal API base for sandbox testing, e.g.
# https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=

# ---------------------------------------------------------------------------
# RBC Move Money API (via Interac e-Transfer) - outgoing payments.
# Official RBC Business Banking API (https://www.rbcroyalbank.com/business/api).
#
# IMPORTANT:
#  * Requires an RBC BUSINESS account and onboarding through your RBC Advisor,
#    who issues the OAuth2 client credentials, the gateway base URL, and your
#    account identifier. There is no official consumer/personal payment API and
#    the RBC card itself cannot be programmed - the integration uses the
#    underlying bank account.
#  * This API sends money OUT of your RBC account to a recipient. It does NOT
#    collect payments from your users.
#  * Executing a payment is gated behind /api/payments/[id]/confirm AND the
#    PAYMENT_ADMINS allowlist below. Nothing is ever marked paid unless RBC
#    confirms it.
#  * Auth follows the Interac Hub OAuth2 client_credentials scheme; the token
#    endpoint is discovered from {base}/.well-known/openid-configuration.
# ---------------------------------------------------------------------------
# OAuth2 client id issued during RBC Advisor onboarding.
RBC_MOVE_MONEY_CLIENT_ID=
# OAuth2 client secret issued during RBC Advisor onboarding (server-only).
RBC_MOVE_MONEY_CLIENT_SECRET=
# Your gateway base URL from onboarding docs (e.g. the API host that serves
# /payments and the OAuth2 token endpoint).
RBC_MOVE_MONEY_BASE_URL=
# Your RBC account that funds transfers.
RBC_MOVE_MONEY_FROM_ACCOUNT_ID=
# Optional: id_type of the from-account (default ACCOUNT_IDENTIFIER).
RBC_MOVE_MONEY_FROM_ACCOUNT_ID_TYPE=
# Optional: payment type (default INTERAC).
RBC_MOVE_MONEY_PAYMENT_TYPE=

# Comma-separated Clerk user ids that are allowed to CONFIRM (authorize) a
# payment, i.e. actually send money via RBC. If unset, no one can authorize -
# payments can be created but never executed.
PAYMENT_ADMINS=

# Optional: persist payment records to disk (JSON) so they survive restarts.
# On Render, point this at a mounted persistent disk, e.g.
# /data/payments.json. Omit for memory-only (records lost on restart).
PAYMENT_STORE_FILE=

# ---------------------------------------------------------------------------
# Gmail OAuth (Google) - real OAuth flow for reading vendor correspondence.
# 1. Create an OAuth client ID in Google Cloud Console (Application type:
#    Web application) for the project that owns your Gmail access.
# 2. Authorized redirect URIs must include exactly:
#      https://<your-domain>/api/gmail/callback
#    (and http://localhost:3000/api/gmail/callback for local dev).
# 3. Download the client_secret_*.json and copy the values here. These are
#    server-only - never expose GOOGLE_OAUTH_CLIENT_SECRET to the browser.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional override; defaults to <origin>/api/gmail/callback per request.
# Set it explicitly when the registered redirect URI differs.
GOOGLE_OAUTH_REDIRECT_URI=

# Encrypts Gmail tokens at rest (AES-256-GCM). Required to persist tokens.
# Generate with: openssl rand -base64 32
GMAIL_TOKEN_SECRET=

# Optional path for the encrypted-at-rest token file so connections survive
# restarts. On Render, point this at a mounted persistent disk, e.g.
# /data/gmail-tokens.json. Omit for memory-only (tokens lost on restart,
# users reconnect).
GMAIL_TOKEN_FILE=

# Optional path for the extraction-job store so in-flight analyses survive
# restarts and resume automatically (defaults to .data/extract-jobs.json).
# On Render, point this at the same mounted persistent disk, e.g.
# /data/extract-jobs.json.
EXTRACT_JOB_FILE=

# Optional one-time redemption codes, as comma-separated `code:plan` pairs,
# e.g. REDEEM_CODES=summit2026:team,launch:business. Codes ONLY come from
# the environment - without this variable the /api/redeem endpoint refuses,
# so no code can unlock a paid plan unless an operator configured it.
REDEEM_CODES=

# ---------------------------------------------------------------------------
# Supabase persistence - server-side workspace data so user info survives
# browsers, devices and logouts (auth stays with Clerk).
# 1. Create a project at https://supabase.com
# 2. Run this SQL in the SQL editor to create the store table:
#      create table if not exists user_data (
#        user_id text primary key,
#        data jsonb not null default '{}'::jsonb,
#        updated_at timestamptz not null default now()
#      );
# 3. Run this SQL to create the uploaded-documents table (authenticated
#    uploads store the file + analysis here; every row is scoped to the
#    Clerk user id and the API layer enforces ownership):
#      create table if not exists documents (
#        id            uuid primary key default gen_random_uuid(),
#        user_id       text not null,
#        filename      text not null,
#        file_kind     text not null default 'unknown',
#        file_size     bigint not null default 0,
#        storage_path  text,
#        status        text not null default 'uploading',
#        error         text,
#        analysis      jsonb,
#        extraction    jsonb,
#        document_name text,
#        created_at    timestamptz not null default now(),
#        updated_at    timestamptz not null default now()
#      );
#      create index if not exists idx_documents_user on documents (user_id);
# 4. Create a private storage bucket named `documents` (Storage > New
#    bucket, public off, 25 MB file limit). `scripts/provision-documents.mjs`
#    creates the bucket automatically and reports whether the table exists.
# 5. Project Settings > API: copy the Project URL and the service_role
#    (secret) key here. Server-only - never expose the secret key.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=